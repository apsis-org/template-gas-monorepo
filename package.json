{
  "name": "template-gas-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Google Apps Script monorepo template using TypeScript, esbuild, and clasp",
  "scripts": {
    "clone": "node scripts/clone.js",
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check && node scripts/check-versions.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/google-apps-script": "^2.0.8",
    "esbuild": "^0.28.2",
    "esbuild-gas-plugin": "^0.10.0",
    "lefthook": "^2.0.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24"
  },
  "packageManager": "pnpm@12.15.0"
}
